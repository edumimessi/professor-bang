# Banco local padrao do MVP
DATABASE_URL=sqlite:///./professor_bang.db

# Origens permitidas separadas por virgula. Em producao, nao use '*'.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5000,http://10.0.2.2:8000

# Ambiente: development ou production
ENV=development

# IA real do tutor pedagogico com Gemini. Se GEMINI_API_KEY ficar vazio, o backend tenta OpenAI e depois usa o motor local antigo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
USE_GEMINI_PEDAGOGY=true

# Fallback opcional com OpenAI. Pode deixar desligado se voce for usar so Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI_PEDAGOGY=false
